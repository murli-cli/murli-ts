# Supply-chain hardening.
# Dependency lifecycle (install/postinstall) scripts are blocked for every package
# EXCEPT the allowlist in package.json -> pnpm.onlyBuiltDependencies (esbuild, @biomejs/biome).

# Refuse to install under a Node that doesn't satisfy "engines" (>=18).
engine-strict=true

# Reproducible installs: never silently mutate the lockfile. `pnpm add` still works;
# a bare `pnpm install` after editing package.json fails loudly instead of drifting.
frozen-lockfile=true

# Re-verify the content-addressable store against integrity hashes on every install
# (detects a tampered local store).
verify-store-integrity=true

# New `pnpm add` pins exact versions instead of caret ranges, shrinking the
# version-range surface a compromised release could slip through.
save-exact=true

# Pin the registry explicitly (dependency-confusion / registry-swap hygiene).
registry=https://registry.npmjs.org/

# No update-check phone-home during install.
update-notifier=false
